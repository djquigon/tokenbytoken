# Copy to .env.local and fill in values. Never commit real values; .env* files are gitignored.
# On Vercel, set these per environment (Preview / Production) in the project settings.

# OpenAI key for this app. Use the development project's key locally and the production project's key on
# Vercel. Server-only: never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Signs replies so earlier turns can't be altered, and derives the hashed IDs used for limits and OpenAI's
# safety_identifier. At least 32 random characters, e.g. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
# Required on Vercel. Locally, a fixed development secret is used when unset.
HISTORY_SIGNING_SECRET=
# During a rotation, put the old secret here so open conversations keep working.
HISTORY_SIGNING_SECRET_PREVIOUS=

# Limits store (rate limits, one-stream lock, daily budget ledger). Required on Vercel: connect Upstash Redis
# through the Vercel Marketplace, which sets KV_REST_API_URL and KV_REST_API_TOKEN (the Upstash console names
# UPSTASH_REDIS_REST_URL/TOKEN also work). Locally, an in-memory store is used when these are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Force the local in-memory store even when Redis variables are present ("memory"); refused on Vercel.
LIMITS_STORE=

# Extra origins allowed to call /api/chat, comma-separated. Same-origin requests are always allowed.
ALLOWED_ORIGINS=
