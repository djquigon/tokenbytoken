# Copy to .env.local and fill in values. Never commit real values; .env* files are gitignored.

# OpenAI key for this app. Use the development project's key locally and the production
# project's key on Vercel. Server-only: never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Phase 0 streaming spike (/spike and /api/spike/*). Leave unset to disable those routes.
# SPIKE_TOKEN gates the route that calls OpenAI; use any long random string.
SPIKE_ENABLED=
SPIKE_TOKEN=
